# Copy this file to .env (which is gitignored -- never commit real
# credentials) and fill in real values before running the pipeline
# container. See NAS_SETUP.md for how these get created on the NAS.
#
# MARKET_BREADTH_PUSHOVER_API / PUSHOVER_KEY replace the
# earlier Twilio SMS integration -- same purpose (best-effort alert on a
# regime flip/divergence, or a failed pipeline run), delivered as a push
# notification instead of a text. Get both at https://pushover.net:
# create an application (dashboard -> "Create an Application/API Token")
# for the API token, and your user key is shown right on the dashboard's
# front page.

# Required -- src/ingestion/eodhd_client.py has no fallback. Get a key at
# https://eodhd.com (Gary already has a paid plan; this is the same
# account/token, just supplied directly to the standalone NAS script
# instead of through Claude's EODHD connector, which this script can't see).
EODHD_API_KEY=

# Required for alerts -- src/alerts/pushover_notify.py has no fallback.
MARKET_BREADTH_PUSHOVER_API=
PUSHOVER_KEY=

# Comma-separated index_keys to send Pushover alerts for (regime flips /
# divergence flags). Every index still gets computed and stored either
# way -- this only gates the notification. Defaults to sp500 only if unset.
ALERT_INDEX_KEYS=sp500
